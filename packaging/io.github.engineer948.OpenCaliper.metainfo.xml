<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.engineer948.OpenCaliper</id>
  <name>OpenCaliper</name>
  <summary>Simple parametric 3D CAD</summary>
  <developer id="io.github.engineer948">
    <name>engineer948</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      OpenCaliper is a small, open-source parametric 3D CAD program for
      designing mechanical parts and objects for 3D printing.
    </p>
    <ul>
      <li>2D sketches with constraints and dimensions</li>
      <li>Extrude, revolve, fillet and chamfer</li>
      <li>Editable history timeline with undo and redo</li>
      <li>Export to STEP, IGES, STL and OBJ; import STEP and IGES</li>
    </ul>
    <p>It is built on Open CASCADE Technology and Qt.</p>
  </description>
  <launchable type="desktop-id">io.github.engineer948.OpenCaliper.desktop</launchable>
  <url type="homepage">https://github.com/engineer948/Open-Caliper</url>
  <url type="bugtracker">https://github.com/engineer948/Open-Caliper/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>A part with a sketch, an extrusion and a fillet</caption>
      <image>https://raw.githubusercontent.com/engineer948/Open-Caliper/main/docs/screenshot.png</image>
    </screenshot>
  </screenshots>
  <provides>
    <binary>opencaliper</binary>
    <mediatype>application/x-opencaliper</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.1" date="2026-10-26">
      <description>
        <p>Dimensions on the model that can be double-clicked to change them; cleaner Windows package.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-25">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
