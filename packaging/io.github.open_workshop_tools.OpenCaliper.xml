<?xml version="1.0" encoding="UTF-8"?>
<!-- File type for OpenCaliper projects, so .ocal files open with the app. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-opencaliper">
    <comment>OpenCaliper project</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.ocal"/>
    <icon name="io.github.open_workshop_tools.OpenCaliper"/>
  </mime-type>
</mime-info>
